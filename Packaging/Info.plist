<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleName</key>
	<string>SoundRouter</string>
	<!-- 沒有宣告語言的話，macOS 會把整個 App 當成單一語言，
	     系統偏好的語言不會被納入比對，Bundle.module 一律回退到開發語言。 -->
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleLocalizations</key>
	<array>
		<string>en</string>
		<string>zh-Hant</string>
	</array>
	<key>CFBundleDisplayName</key>
	<string>SoundRouter</string>
	<key>CFBundleIdentifier</key>
	<string>com.soundrouter.app</string>
	<key>CFBundleExecutable</key>
	<string>SoundRouter</string>
	<!-- 由 Packaging/make-icon.swift 產生，build-app.sh 會複製到 Contents/Resources。 -->
	<key>CFBundleIconFile</key>
	<string>AppIcon</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>0.1.0</string>
	<key>CFBundleVersion</key>
	<string>1</string>
	<key>LSMinimumSystemVersion</key>
	<string>14.4</string>
	<!-- 只在選單列出現，不進 Dock、不佔用 App 切換器。 -->
	<key>LSUIElement</key>
	<true/>
	<!-- Core Audio process tap 需要這把鑰匙，否則系統連授權提示都不會跳，直接餵靜音。 -->
	<key>NSAudioCaptureUsageDescription</key>
	<string>SoundRouter needs to capture other apps' audio to route each of them to its own output device and adjust its volume separately.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>SoundRouter needs audio capture permission to reroute each app's sound.</string>
</dict>
</plist>
